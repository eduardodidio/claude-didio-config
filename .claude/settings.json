{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/didio-second-brain-claude/patterns/hooks/stop-session-summary/hook.sh"
          },
          {
            "type": "command",
            "command": "bash {{DIDIO_SECOND_BRAIN_HOME}}/patterns/hooks/stop-session-summary/hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/didio-second-brain-claude/patterns/hooks/no-pending-work-alert/hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/didio-second-brain-claude/patterns/hooks/rate-limit-alert/hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/claude-didio-config/patterns/hooks/feature-end-digest/hook.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/didio-second-brain-claude/patterns/hooks/subagent-stop-progress/hook.sh"
          },
          {
            "type": "command",
            "command": "bash {{DIDIO_SECOND_BRAIN_HOME}}/patterns/hooks/subagent-stop-progress/hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/bin/hooks/didio-pre-tool.sh"
          },
          {
            "type": "command",
            "command": "bash {{DIDIO_HOME}}/bin/hooks/didio-pre-tool.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/eduardodidio/didio-second-brain-claude/patterns/hooks/post-tool-use-error/hook.sh"
          },
          {
            "type": "command",
            "command": "bash {{DIDIO_SECOND_BRAIN_HOME}}/patterns/hooks/post-tool-use-error/hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/bin/hooks/didio-post-tool.sh"
          },
          {
            "type": "command",
            "command": "bash {{DIDIO_HOME}}/bin/hooks/didio-post-tool.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "second-brain": {
      "command": "bun",
      "args": [
        "run",
        "/Users/eduardodidio/didio-second-brain-claude/mcp-server/src/index.ts"
      ],
      "env": {}
    }
  },
  "permissions": {
    "allow": [
      "Bash(didio:*)",
      "Bash(didio-spawn-agent*)",
      "Bash(didio-run-wave*)",
      "Bash(didio-dashboard*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git init:*)",
      "Bash(git -c user.name=*)",
      "Bash(mkdir -p:*)",
      "Bash(cp -r:*)",
      "Bash(npm install:*)",
      "Bash(npm run *)",
      "Bash(curl:*)",
      "Read(./**)",
      "Write(tasks/**)",
      "Write(docs/**)",
      "Write(logs/**)",
      "Edit(./**)",
      "WebSearch",
      "WebFetch",
      "AskUserQuestion"
    ]
  }
}
