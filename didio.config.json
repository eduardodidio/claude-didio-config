      "fallback": "haiku"
    }
  },
  "retrospective": {
    "feature": true,
    "bugfix": true,
    "review": true
  },
  "second_brain": {
    "enabled": false,
    "fallback_to_local": true,
    "home": ""
  },
  "session_guard": {
    "enabled": true,
    "source": "ccusage",
    "soft_pct": 0.9,
    "hard_pct": 0.9,
    "resume_buffer_minutes": 5,
    "max_resumes_per_day": 3,
    "notify": true,
    "window_duration_minutes": 300,
    "window_limit_tokens": 200000000,
    "max_snapshot_age_secs": 300
  },
  "sharding": {
    "enabled": true,
    "brief_lines_threshold": 150,
    "task_count_threshold": 6
  },
  "tea": {
    "enabled": true
  },
  "meta_agents": {
    "handler": {
      "enabled": true,
      "auto_governance": true
    },
    "gatekeeper": {
      "enabled": true,
      "review_mode": "post-decision",
      "escalation_blocks_pipeline": true
    },
    "blackhawk_alpha": {
      "enabled": true,
      "observes": [
        "handler",
        "gatekeeper"
      ],
      "can_raise_cards": true
    },
    "blackhawk_bravo": {
      "enabled": true,
      "observes": [
        "handler",
        "gatekeeper"
      ],
      "can_raise_cards": true,
      "monitoring_interval_minutes": 15
    }
  },
  "research": {
    "web_search_budget": 5,
    "web_fetch_budget": 3
  },
  "poc": {
    "default_style_ref": "/Users/eduardodidio/mellon-magic-maker",
    "smoke_timeout_secs": 30,
    "install_timeout_secs": 180,
    "build_timeout_secs": 60
  },
  "graphify": {
    "enabled": false,
    "auto_index": false,
    "output_dir": "graphify-out",
    "query_before_read": true
  },
  "rtk": {
    "enabled": false
  },
  "persona": {
    "theme": "default",
    "handler_name": "Handler",
    "gatekeeper_name": "GateKeeper"
  },
  "negotiation": {
    "max_rounds": 3,
    "post_work_review": true,
    "escalation_summary": true
  },
  "pipeline": {
    "autonomous": true,
    "monitor_poll_interval_secs": 5,
    "signal_dir": "logs/agents/signals",
    "state_dir": "logs/agents"
  },
  "token_monitor": {
    "enabled": true,
    "check_interval_minutes": 10,
    "suggest_scheduling": true,
    "schedule_method": "at"
  },
  "blackhawk": {
    "enabled": true,
    "auto_triage": true,
    "triage_interval_minutes": 30,
    "knowledge_sources": [
      "adr",
      "learnings",
      "retrospectives"
    ],
    "max_concurrent_promotions": 2,
    "promotion_requires_confirmation": false,
    "defer_auto_archive_days": 30,
    "auto_launch": true,
    "silent_mode": false,
    "avatar_path": "",
    "notification_sound": true,
    "chat_history_days": 30,
    "desktop_app": {
      "width": 400,
      "height": 600,
      "position": "bottom-right"
    }
  },
  "mesh": {
    "enabled": true,
    "registry_path": "~/.didio/mesh-registry.json",
    "auto_sync_on_retro": true
  },
  "dob": {
    "enabled": false,
    "k": 3,
    "fixtures_dir": "tests/dob-fixtures",
    "results_dir": "logs/dob-results",
    "dimensions_schema": "docs/dob-dimensions.json",
    "regression": {
      "threshold_pct": 10,
      "block_on_regression": true
    }
  }
}
