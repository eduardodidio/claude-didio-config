{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/master/schemars/tauri.conf.json",
  "productName": "Black Hawk Desktop",
  "version": "0.1.0",
  "identifier": "com.didio.blackhawk-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Black Hawk",
        "width": 400,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Black Hawk Desktop"
    },
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "autostart": { "macosLaunchAgent": true },
    "notification": { "all": true },
    "fs": {
      "scope": {
        "allow": [
          "$APPDATA/**",
          "$HOME/.claude-didio-config/**"
        ]
      }
    }
  }
}
