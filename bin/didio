#!/usr/bin/env bash
# didio — entry point for claude-didio-config framework
# Usage: didio <subcommand> [args...]
set -euo pipefail

DIDIO_HOME="${DIDIO_HOME:-$HOME/.claude-didio-config}"
SUBCMD="${1:-}"
shift || true

case "$SUBCMD" in
  spawn-agent)   exec "$DIDIO_HOME/bin/didio-spawn-agent.sh" "$@" ;;
  run-wave)      exec "$DIDIO_HOME/bin/didio-run-wave.sh" "$@" ;;
  dashboard)     exec "$DIDIO_HOME/bin/didio-dashboard.sh" "$@" ;;
  install-second-brain)
    exec "$DIDIO_HOME/bin/didio-install-second-brain.sh" "$@"
    ;;
  log-watcher)   exec "$DIDIO_HOME/bin/didio-log-watcher.sh" "$@" ;;
  easter-egg)    exec "$DIDIO_HOME/bin/didio-easter-egg.sh" "$@" ;;
  sync-project)  exec "$DIDIO_HOME/bin/didio-sync-project.sh" "$@" ;;
  sync-all)        exec "$DIDIO_HOME/bin/didio-sync-all.sh" "$@" ;;
  poc-from-minutes) exec "$DIDIO_HOME/bin/didio-poc-from-minutes.sh" "$@" ;;
  compile-skills)  exec "$DIDIO_HOME/bin/didio-compile-skills.sh" "$@" ;;
  providers)       exec "$DIDIO_HOME/bin/didio-providers.sh" "$@" ;;
  resume-pending)  exec "$DIDIO_HOME/bin/didio-resume-pending.sh" "$@" ;;
  handler)         exec "$DIDIO_HOME/bin/didio-handler.sh" "$@" ;;
  gatekeeper)      exec "$DIDIO_HOME/bin/didio-gatekeeper.sh" "$@" ;;
  t800)            exec "$DIDIO_HOME/bin/didio-handler.sh" "$@" ;;   # backward-compat alias
  t1000)           exec "$DIDIO_HOME/bin/didio-gatekeeper.sh" "$@" ;; # backward-compat alias
  decisions)       exec "$DIDIO_HOME/bin/didio-decisions.sh" "$@" ;;
  meta-metrics)    exec "$DIDIO_HOME/bin/didio-meta-metrics.sh" "$@" ;;
  graphify)          exec "$DIDIO_HOME/bin/didio-graphify.sh" "$@" ;;
  install-graphify)  exec "$DIDIO_HOME/bin/didio-install-graphify.sh" "$@" ;;
  rtk)               exec "$DIDIO_HOME/bin/didio-rtk.sh" "$@" ;;
  install-rtk)       exec "$DIDIO_HOME/bin/didio-install-rtk.sh" "$@" ;;
  action-listener)   exec "$DIDIO_HOME/bin/didio-action-listener.sh" "$@" ;;
  post-review)       exec "$DIDIO_HOME/bin/didio-post-review.sh" "$@" ;;
  flag)              exec "$DIDIO_HOME/bin/didio-flag.sh" "$@" ;;
  warroom)           exec "$DIDIO_HOME/bin/didio-warroom.sh" "$@" ;;
  token-monitor)     exec "$DIDIO_HOME/bin/didio-token-monitor.sh" "$@" ;;
  pipeline-status)   exec "$DIDIO_HOME/bin/didio-pipeline-status.sh" "$@" ;;
  pipeline-pause)    exec "$DIDIO_HOME/bin/didio-pipeline-pause.sh" "$@" ;;
  pipeline-resume)   exec "$DIDIO_HOME/bin/didio-pipeline-resume.sh" "$@" ;;
  run-pipeline)      exec "$DIDIO_HOME/bin/didio-run-pipeline.sh" "$@" ;;
  learnings-export)  exec "$DIDIO_HOME/bin/didio-learnings-export.sh" "$@" ;;
  learnings-import)  exec "$DIDIO_HOME/bin/didio-learnings-import.sh" "$@" ;;
  learnings-sync)    exec "$DIDIO_HOME/bin/didio-learnings-sync.sh" "$@" ;;
  machine-scan)      exec "$DIDIO_HOME/bin/didio-machine-scan.sh" "$@" ;;
  dob-run)           exec "$DIDIO_HOME/bin/didio-dob-runner.sh" "$@" ;;
  dob-score)         exec "$DIDIO_HOME/bin/didio-dob-scorer.sh" "$@" ;;
  dob-regression)    exec "$DIDIO_HOME/bin/didio-dob-regression.sh" "$@" ;;
  blackhawk)
    BH_SUB="${1:-}"
    shift || true
    case "$BH_SUB" in
      monitor)  exec "$DIDIO_HOME/bin/didio-blackhawk-monitor.sh" "$@" ;;
      triage)   exec "$DIDIO_HOME/bin/didio-blackhawk-triage.sh" "$@" ;;
      promote)  exec "$DIDIO_HOME/bin/didio-blackhawk-promote.sh" "$@" ;;
      defer)    exec "$DIDIO_HOME/bin/didio-blackhawk-defer.sh" "$@" ;;
      help|--help|-h|"")
        echo "Usage: didio blackhawk <subcommand> [args...]"
        echo ""
        echo "Subcommands:"
        echo "  monitor   Run governance pattern detection + strategic cards"
        echo "  triage    Run Black Hawk Alpha triage on War Room cards"
        echo "  promote   Promote a triaged card to a Standard Board feature"
        echo "  defer     Defer a card with rationale"
        echo ""
        echo "Run 'didio blackhawk <subcommand> --help' for details."
        ;;
      *)
        echo "didio blackhawk: unknown subcommand '$BH_SUB'. Try 'didio blackhawk help'." >&2
        exit 1
        ;;
    esac
    ;;
  overlord)
    # Backward-compat alias: overlord -> blackhawk
    exec "$0" blackhawk "$@"
    ;;
  menu|"")         exec "$DIDIO_HOME/bin/didio-menu.sh" "$@" ;;
  version)       echo "didio $(cat "$DIDIO_HOME/VERSION" 2>/dev/null || echo dev)" ;;
  help|-h|--help)
    cat <<EOF
didio — claude-didio-config framework

Usage:
  didio                        (no args) open the interactive menu
  didio menu                   same as above

  didio spawn-agent <role> <feature-id> <task-file> [extra-prompt]
      Launch a single agent in a clean bash context via 'claude -p'.
      Roles: architect | developer | techlead | qa | readiness | tea | handler | gatekeeper | blackhawk-alpha
      Aliases: t800 -> handler, t1000 -> gatekeeper
      Logs streamed to logs/agents/<feature>-<role>-<taskid>-<ts>.jsonl

  didio run-wave <feature-id> <wave-number>
      Run all tasks of a given Wave in parallel (one spawn-agent per task).
      Reads tasks/features/<feature>/<feature>-README.md for Wave manifest.

  didio dashboard [port]
      Start monitoring dashboard (default port 7777) and open in browser.

  didio install-second-brain [PATH]
      Clone or update didio-second-brain-claude (default: $HOME/didio-second-brain-claude).
      Idempotent: re-running on an existing checkout does a git pull --ff-only.

  didio log-watcher
      Aggregate logs/agents/*.jsonl into logs/agents/state.json for the dashboard.

  didio easter-egg <role> <exit_code>
      Print a thematic one-liner for the given role+outcome.
      Honors DIDIO_EASTER_EGGS=0 to disable.

  didio sync-project <target-project-path>
      Idempotent sync of framework templates into a downstream project.
      Creates a rollback git tag, copies missing files, merges settings.json
      allow arrays, and appends missing CLAUDE.md sections. Safe: never
      deletes files, never overwrites content beyond the template placeholder.

  didio sync-all [target-projects.json]
      Run sync-project for every project listed in target-projects.json.
      Default config: tasks/features/F04-sync-downstream/target-projects.json

  didio poc-from-minutes <ata>   Generate runnable POC from meeting minutes

  didio compile-skills [--target claude] [--dry-run]
      Compile skills/*.md (neutral format, see skills/SPEC.md) into
      .claude/commands, .claude/agents, agents/prompts. --dry-run prints
      what would change without writing.

  didio providers [list|validate]
      list      Show configured providers (didio.config.json 'providers')
                and whether their CLI binary is found on PATH.
      validate  Check only the providers actually used by roles in the
                active config; exits 1 listing any missing CLI binaries.

  didio handler <feature-id> <brief-or-request-file> [extra-prompt]
      Spawn Handler strategic orchestrator. Produces decision records
      in logs/decisions/. If auto_governance=true, spawns GateKeeper after.
      Disabled by default (meta_agents.handler.enabled).
      Alias: didio t800

  didio gatekeeper --decision <id> | --pending
      Spawn GateKeeper governance reviewer on a Handler decision.
      Reviews the decision for biases and blind spots.
      Disabled by default (meta_agents.gatekeeper.enabled).
      Alias: didio t1000

  didio decisions --recent [N] | --status <s> | --detail <id>
      View decision log. Lists, filters, or shows detail of Handler
      decision records from logs/decisions/.

  didio meta-metrics [--root <path>]
      Compute meta-agent KPI report from live logs (Handler + GateKeeper).
      Writes logs/agents/meta-metrics.json and prints a text report.

  didio graphify [args...]
      Run graphify CLI (knowledge graph). Requires graphify.enabled=true
      in didio.config.json and graphify binary on PATH.
      Install with: didio install-graphify

  didio install-graphify
      Install the Graphify CLI via uv tool install graphifyy.
      Downloads tree-sitter grammars automatically.

  didio rtk [args...]
      Run RTK CLI (context compression). Requires rtk.enabled=true
      in didio.config.json and rtk binary on PATH.
      Install with: didio install-rtk

  didio install-rtk
      Install the RTK CLI. Does NOT auto-run 'rtk init -g' (manual step).

  didio post-review <feature-id>
      Run post-work review gate after QA completes. Handler reviews the
      feature output, then GateKeeper validates via negotiation loop.
      Disabled when negotiation.post_work_review=false.
      Exit 0=approved, 2=escalated (human review needed).

  didio flag raise <feature> <type> [task] [message]
  didio flag resolve <feature> <type> [task]
  didio flag list [--feature FXX] [--unresolved]
  didio flag is-blocked <feature> [task]
      Manage pipeline flags (blocked, needs_review, escalated, warning, info).
      Flags are stored as JSON in logs/agents/flags/.

  didio warroom add "title" [--body "text"] [--tags "a,b"] [--priority medium]
  didio warroom list [--status <s>] [--all] [--format table|json]
  didio warroom show <card_id>
  didio warroom move <card_id> <status>
      Manage War Room cards (incoming ideas, requests, signals).
      Cards are stored as JSON in logs/warroom/cards/.

  didio blackhawk triage [--dry-run]
  didio blackhawk promote <card-id>
  didio blackhawk defer <card-id>
  didio blackhawk monitor
      Black Hawk Alpha strategic command. Triage incoming War Room cards,
      promote cards to features, defer cards with rationale, or
      monitor governance patterns.
      (Alias: didio overlord ... still works for backward compatibility.)

  didio action-listener [--interval SECS] [--once]
      Poll logs/agents/actions/ for operator action JSON files and
      process them (unblock, approve, skip, pause, resume, cancel).
      Processed files are archived to logs/agents/actions/archive/.
      --once processes pending actions and exits (no loop).

  didio run-pipeline <feature-id> <brief-or-file> [--skip-handler] [--skip-readiness] [--skip-tea] [--skip-post-review]
      Run the FULL autonomous pipeline for a feature:
      Handler -> Architect -> Readiness -> TEA -> Waves -> TechLead -> QA -> Post-review.
      Tracks state in logs/agents/pipeline-<FXX>.state.json.
      Supports pause/resume/cancel via signal files in logs/agents/signals/.
      Exit 0=success, 1=failed, 2=escalated, 3=token-budget-paused, 4=cancelled.

  didio token-monitor [--check-only | --suggest]
      Analyze token budget, project depletion, and suggest scheduling
      for pipeline resumption.  --check-only prints OK/WARNING/CRITICAL.
      --suggest outputs JSON with at/cron scheduling commands.

  didio learnings-export [--output FILE] [--role ROLE] [--since DATE]
      Export agent learnings from memory/agent-learnings/*.md to JSON.
      Default output: logs/agents/shared-learnings-export.json

  didio learnings-import <input-file.json> [--role ROLE] [--dry-run]
      Import shared learnings from a JSON file into local memory files.
      Appends new lessons under "## Imported Learnings" section.

  didio learnings-sync <shared-repo-path>
      Bidirectional sync: exports local learnings then imports from
      other projects in <shared-repo-path>/learnings/.

  didio blackhawk monitor [--dry-run] [--since YYYY-MM-DD] [--continuous]
      Run Black Hawk Alpha governance pattern detection. Scans decision/governance
      logs for repeated challenges, blocked pipelines, low confidence,
      escalation frequency, stale flags, and token budget pressure.
      Creates strategic War Room cards when patterns are detected.

  didio blackhawk triage [args...]
      Run Black Hawk Alpha triage on War Room cards.

  didio resume-pending [--feature FXX] [--dry-run] [--max-retries N]
      Scan logs/agents/_pending/ and re-spawn rate-limited jobs whose
      reset has passed. Idempotent (lockfile + atomic consume).
      See ADR-0014 for the pending JSON schema.

  didio pipeline-status [<feature-id>]
      Show status of active pipelines. Without arguments lists all
      pipelines in a summary table. With a feature-id shows detailed
      stage-by-stage status for that pipeline.

  didio pipeline-pause <feature-id>
      Pause a running pipeline. Creates a pause signal file so the
      pipeline will stop after its current stage completes.

  didio pipeline-resume <feature-id>
      Resume a paused pipeline. Creates a resume signal file so the
      pipeline continues from the stage where it paused.

  didio machine-scan [--json] [--quiet] [--write]
      Detect hardware (CPU, RAM, OS, arch, Rust, claude sessions) and
      suggest optimal max_parallel for agent parallelism.
      --json outputs machine-readable JSON. --write updates didio.config.json.

  didio version
      Print framework version.

Rate-limit handling (F22):
  --on-rate-limit=<mode>   Applies to spawn-agent and run-wave.
                           wait (default) | schedule | fail-fast.
  --max-retries=<N>        Retry budget per spawn (default: 3).
  DIDIO_CI=1               Force fail-fast in non-interactive runs.
  For the full reference:  didio spawn-agent --help

Environment:
  DIDIO_HOME   Framework install directory (default: ~/.claude-didio-config)
EOF
    ;;
  *)
    echo "didio: unknown subcommand '$SUBCMD'. Try 'didio help'." >&2
    exit 1
    ;;
esac
