#!/usr/bin/env bash
# didio — entry point for claude-didio-config framework
# Usage: didio <subcommand> [args...]
set -euo pipefail

DIDIO_HOME="${DIDIO_HOME:-$HOME/.claude-didio-config}"
SUBCMD="${1:-}"
shift || true

case "$SUBCMD" in
  spawn-agent)   exec "$DIDIO_HOME/bin/didio-spawn-agent.sh" "$@" ;;
  run-wave)      exec "$DIDIO_HOME/bin/didio-run-wave.sh" "$@" ;;
  dashboard)     exec "$DIDIO_HOME/bin/didio-dashboard.sh" "$@" ;;
  install-second-brain)
    exec "$DIDIO_HOME/bin/didio-install-second-brain.sh" "$@"
    ;;
  log-watcher)   exec "$DIDIO_HOME/bin/didio-log-watcher.sh" "$@" ;;
  easter-egg)    exec "$DIDIO_HOME/bin/didio-easter-egg.sh" "$@" ;;
  sync-project)  exec "$DIDIO_HOME/bin/didio-sync-project.sh" "$@" ;;
  sync-all)        exec "$DIDIO_HOME/bin/didio-sync-all.sh" "$@" ;;
  poc-from-minutes) exec "$DIDIO_HOME/bin/didio-poc-from-minutes.sh" "$@" ;;
  resume-pending)  exec "$DIDIO_HOME/bin/didio-resume-pending.sh" "$@" ;;
  t800)            exec "$DIDIO_HOME/bin/didio-t800.sh" "$@" ;;
  t1000)           exec "$DIDIO_HOME/bin/didio-t1000.sh" "$@" ;;
  decisions)       exec "$DIDIO_HOME/bin/didio-decisions.sh" "$@" ;;
  meta-metrics)    exec "$DIDIO_HOME/bin/didio-meta-metrics.sh" "$@" ;;
  menu|"")         exec "$DIDIO_HOME/bin/didio-menu.sh" "$@" ;;
  version)       echo "didio $(cat "$DIDIO_HOME/VERSION" 2>/dev/null || echo dev)" ;;
  help|-h|--help)
    cat <<EOF
didio — claude-didio-config framework

Usage:
  didio                        (no args) open the interactive menu
  didio menu                   same as above

  didio spawn-agent <role> <feature-id> <task-file> [extra-prompt]
      Launch a single agent in a clean bash context via 'claude -p'.
      Roles: architect | developer | techlead | qa | readiness | tea | t800 | t1000
      Logs streamed to logs/agents/<feature>-<role>-<taskid>-<ts>.jsonl

  didio run-wave <feature-id> <wave-number>
      Run all tasks of a given Wave in parallel (one spawn-agent per task).
      Reads tasks/features/<feature>/<feature>-README.md for Wave manifest.

  didio dashboard [port]
      Start monitoring dashboard (default port 7777) and open in browser.

  didio install-second-brain [PATH]
      Clone or update didio-second-brain-claude (default: $HOME/didio-second-brain-claude).
      Idempotent: re-running on an existing checkout does a git pull --ff-only.

  didio log-watcher
      Aggregate logs/agents/*.jsonl into logs/agents/state.json for the dashboard.

  didio easter-egg <role> <exit_code>
      Print a thematic one-liner for the given role+outcome.
      Honors DIDIO_EASTER_EGGS=0 to disable.

  didio sync-project <target-project-path>
      Idempotent sync of framework templates into a downstream project.
      Creates a rollback git tag, copies missing files, merges settings.json
      allow arrays, and appends missing CLAUDE.md sections. Safe: never
      deletes files, never overwrites content beyond the template placeholder.

  didio sync-all [target-projects.json]
      Run sync-project for every project listed in target-projects.json.
      Default config: tasks/features/F04-sync-downstream/target-projects.json

  didio poc-from-minutes <ata>   Generate runnable POC from meeting minutes

  didio t800 <feature-id> <brief-or-request-file> [extra-prompt]
      Spawn Gandalf strategic orchestrator. Produces decision records
      in logs/decisions/. If auto_governance=true, spawns Saruman after.
      Disabled by default (meta_agents.t800.enabled).

  didio t1000 --decision <id> | --pending
      Spawn Saruman governance reviewer on a Gandalf decision.
      Reviews the decision for biases and blind spots.
      Disabled by default (meta_agents.t1000.enabled).

  didio decisions --recent [N] | --status <s> | --detail <id>
      View decision log. Lists, filters, or shows detail of Gandalf
      decision records from logs/decisions/.

  didio meta-metrics [--root <path>]
      Compute meta-agent KPI report from live logs (Gandalf + Saruman).
      Writes logs/agents/meta-metrics.json and prints a text report.

  didio resume-pending [--feature FXX] [--dry-run] [--max-retries N]
      Scan logs/agents/_pending/ and re-spawn rate-limited jobs whose
      reset has passed. Idempotent (lockfile + atomic consume).
      See ADR-0014 for the pending JSON schema.

  didio version
      Print framework version.

Rate-limit handling (F22):
  --on-rate-limit=<mode>   Applies to spawn-agent and run-wave.
                           wait (default) | schedule | fail-fast.
  --max-retries=<N>        Retry budget per spawn (default: 3).
  DIDIO_CI=1               Force fail-fast in non-interactive runs.
  For the full reference:  didio spawn-agent --help

Environment:
  DIDIO_HOME   Framework install directory (default: ~/.claude-didio-config)
EOF
    ;;
  *)
    echo "didio: unknown subcommand '$SUBCMD'. Try 'didio help'." >&2
    exit 1
    ;;
esac
